-- ========================================================
-- System & Logic (ระบบการทำงาน)
-- ========================================================

-- 1. ระบบลากหน้าต่าง (Dragging System)
local dragging, dragInput, dragStart, startPos

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

Header.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- 2. ระบบย่อ/ขยาย หน้าต่าง (Minimize System)
local isMinimized = false
MinBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        Content.Visible = false
        TweenService:Create(MainFrame, TweenInfo.new(0.2), {Size = UDim2.new(0, 320, 0, 35)}):Play()
        MinBtn.Text = "+"
    else
        TweenService:Create(MainFrame, TweenInfo.new(0.2), {Size = UDim2.new(0, 320, 0, 360)}):Play()
        task.wait(0.2)
        Content.Visible = true
        MinBtn.Text = "-"
    end
end)

CloseBtn.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
end)

-- Function สำหรับรันโค้ด Lua
local function ExecuteCode()
    local code = CodeInput.Text
    if code ~= "" then
        local func, err = loadstring(code)
        if func then
            task.spawn(func)
            return true
        else
            warn("Code Error: " .. tostring(err))
            StatusLabel.Text = "สถานะ: โค้ดมีข้อผิดพลาด!"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            return false
        end
    end
    return false
end

-- 3. รันครั้งเดียว
RunOnceBtn.MouseButton1Click:Connect(function()
    if ExecuteCode() then
        StatusLabel.Text = "สถานะ: รันโค้ดสำเร็จ (1 ครั้ง)"
        StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    end
end)

-- 4. รันรัวๆ (Loop Run)
local isLooping = false
LoopRunBtn.MouseButton1Click:Connect(function()
    isLooping = not isLooping
    if isLooping then
        LoopRunBtn.Text = "รันรัวๆ: ON"
        LoopRunBtn.BackgroundColor3 = Color3.fromRGB(60, 180, 80)
        StatusLabel.Text = "สถานะ: กำลังรันวนลูป..."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 220, 100)

        task.spawn(function()
            while isLooping do
                ExecuteCode()
                local delayTime = tonumber(DelayInput.Text) or 1.0
                task.wait(math.max(0.05, delayTime)) -- ล็อคขั้นต่ำไว้ที่ 0.05 วินาที
            end
        end)
    else
        LoopRunBtn.Text = "รันรัวๆ: OFF"
        LoopRunBtn.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
        StatusLabel.Text = "สถานะ: หยุดการรันวนลูป"
        StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
end)

